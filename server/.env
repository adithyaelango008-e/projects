# ─────────────────────────────────────────────────────────────────────────────
# Twilio credentials for OTP SMS
# Sign up free at https://www.twilio.com/try-twilio
# Then get these values from your Twilio Console dashboard
# ─────────────────────────────────────────────────────────────────────────────

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ─────────────────────────────────────────────────────────────────────────────
# NOTE: If you leave the above values unchanged, OTPs will be printed
# to the server console instead of being sent via SMS (good for testing).
# ─────────────────────────────────────────────────────────────────────────────
